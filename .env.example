# 用独立字段拼连接串，避免密码里的 # 被当成 URL fragment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sagematch

ADMIN_PASSWORD=sagematch-admin
ANONYMOUS_USER_ID=local-user

# 兜底模型,若管理端agent角色未进行模型配置,使用兜底模型的配置
# Anthropic Messages 兼容端点（与 EchoMind 同一套协议）
LLM_API_KEY=
LLM_BASE_URL=
